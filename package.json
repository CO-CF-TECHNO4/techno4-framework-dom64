{
  "name": "dom64",
  "version": "0.1.1",
  "description": "DOM64 – Document Object Model manipulation library.",
  "sideEffects": false,
  "main": "package/dom64.js",
  "types": "package/dom64.d.ts",
  "module": "package/dom64.esm.js",
  "exports": {
    ".": {
      "import": "./package/dom64.esm.js",
      "require": "./package/dom64.js",
      "types": "./package/dom64.d.ts"
    }
  },
  "scripts": {
    "build:dev": "cross-env NODE_ENV=development node ./scripts/build",
    "build:prod": "cross-env NODE_ENV=production node ./scripts/build",
    "serve": "serve",
    "prettier": "prettier \"**/*.+(js|json|scss)\"",
    "format": "npm run prettier -- --write",
    "check-format": "npm run prettier -- --list-different",
    "lint": "eslint --ext .js,.ts,.tsx .",
    "validate": "npm-run-all --parallel test check-format lint",
    "release": "npm run validate && node ./scripts/release",
    "changelog": "npx conventional-changelog -p angular -i CHANGELOG.md -u -s"
  },
  "files": [
    "package",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:CO-CF-TECHNO4/techno4-framework-dom64.git"
  },
  "keywords": [
    "dom64"
  ],
  "author": "CO «CF TECHNO4» <office@techno4.online>",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/CO-CF-TECHNO4/techno4-framework-dom64/issues"
  },
  "homepage": "https://techno4.online",
  "devDependencies": {
    "@babel/core": "^7.14.8",
    "@babel/preset-env": "^7.14.8",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-node-resolve": "^13.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^7.31.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^3.4.0",
    "exec-sh": "^0.4.0",
    "fs-extra": "^10.0.0",
    "inquirer": "^8.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "rollup": "^2.53.3",
    "serve": "^12.0.0",
    "terser": "^5.7.1"
  },
  "dependencies": {
    "ssr-window": "^4.0.0"
  }
}
